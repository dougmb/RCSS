# ──────────────────────────────────────────────────────────────────────────────
# Backup Configuration - RCSS
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Root directory containing the project backup folders (e.g.: /opt/backups/MYPROJECT)
BACKUP_ROOT="/mnt/HDD"

# rclone remote name as configured via `rclone config` (e.g.: "drive:" or "douglas:")
RCLONE_REMOTE="douglas:"

# ── Local Cleanup ─────────────────────────────────────────────────────────────
#
# What happens to the LOCAL files AFTER a successful upload. Nothing is ever
# deleted when the upload fails.
#
#   "retention" → delete only files older than RETENTION_DAYS (default)
#   "always"    → delete every uploaded file, ignoring RETENTION_DAYS
#   "never"     → keep everything locally; the cloud copy is a duplicate, not a move
#
# Overridable per run: -D forces "always", -k forces "never", -n (dry-run) deletes nothing.
LOCAL_CLEANUP="retention"

# Days to keep backups LOCALLY. Only used when LOCAL_CLEANUP="retention".
RETENTION_DAYS=1

# ── Remote Retention ──────────────────────────────────────────────────────────

# Days to keep backups in the CLOUD, applied by cleanRemoteBackups.sh.
# Completely independent from RETENTION_DAYS / LOCAL_CLEANUP above.
REMOTE_RETENTION_DAYS=15

# ── Cloud ─────────────────────────────────────────────────────────────────────

# Destination folder on Google Drive (created at the root of your Drive).
DRIVE_DESTINATION=""

# REMOTE_CLEANUP_SAFETY_DAYS
# Remote cleanup (cleanRemoteBackups.sh) is blocked if no backup newer than
# this many days is found — prevents wiping history if uploads have stopped.
REMOTE_CLEANUP_SAFETY_DAYS=2

# ── Upload Behavior ───────────────────────────────────────────────────────────

# Folders inside BACKUP_ROOT to skip (space-separated). These are never treated as projects.
IGNORED_FOLDERS="scripts config bin logs lost+found"

# If "true", hidden files/folders (starting with .) are excluded from upload.
# Protects sensitive files like .env, .git/, .ssh/. Default: "false".
SKIP_DOTFILES="false"

# UPLOAD_ROOT_FILES
# If "true", files sitting loose in BACKUP_ROOT (outside any project folder) are
# also uploaded, to the root of DRIVE_DESTINATION. The active log file is never
# included. Set to "false" to upload project folders only. Default: "true".
UPLOAD_ROOT_FILES="true"

# ── Logging ───────────────────────────────────────────────────────────────────

# Log file path. If omitted, defaults to the script directory (sync.log).
# LOG_FILE="/opt/backups/scripts/sync.log"

# ── Notifications ─────────────────────────────────────────────────────────────
#
# ⚠️  SECURITY: this file is tracked by git. NEVER commit real credentials here.
#     Fill the values below only in the local copy of each server (after a
#     `git pull`), and keep the placeholders empty in any commit.
#
# Requires `curl` (used to talk to the SMTP server).

# Address(es) that receive the error alerts. Accepts more than one, separated by
# comma and/or space: NOTIFY_EMAIL_TO="admin@example.com, ops@example.com"
# LEAVE EMPTY TO DISABLE notifications entirely (default behavior).
NOTIFY_EMAIL_TO=""

# Sender address. If empty, NOTIFY_EMAIL_TO is used as the sender.
NOTIFY_EMAIL_FROM=""

# Prefix prepended to the e-mail subject — useful to filter/label the alerts.
NOTIFY_SUBJECT_PREFIX="[RCSS]"

# SMTP server used to send the alerts (e.g.: "smtp.gmail.com").
SMTP_HOST=""

# SMTP port. 587 = STARTTLS (most common).
SMTP_PORT="587"

# SMTP credentials. For Gmail, use an app password (not the account password).
# Leave SMTP_USER empty for relays that do not require authentication.
SMTP_USER=""
SMTP_PASSWORD=""
